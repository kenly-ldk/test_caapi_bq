# Copy this file to `config.env` (gitignored) and fill in real values.
# The scripts source config.env and pass --project explicitly to every gcloud
# call — no gcloud-config or workstation coupling is baked into these scripts.

# --- Identity / project ---
PROJECT_ID=your-gcp-project
REGION=us-central1
SERVICE_NAME=sf-trees-demo

# Runtime service account attached to the Cloud Run service (model 2).
# Leave blank to use the project's default compute SA (model 1 — not recommended).
RUNTIME_SA=ca-demo@your-gcp-project.iam.gserviceaccount.com

# --- App behavior (passed to the container as env vars) ---
# BILLING_PROJECT is the API `parent` + BigQuery billing project (usually PROJECT_ID).
BILLING_PROJECT=your-gcp-project
LOCATION=global

# adc | impersonate | end_user
IDENTITY_MODE=adc

# Target SA for IDENTITY_MODE=impersonate (model 3). Runtime SA needs
# roles/iam.serviceAccountTokenCreator on it.
TARGET_SA=data-reader@your-gcp-project.iam.gserviceaccount.com

# Principal allowed to invoke the service (model: run.invoker on the service).
INVOKER_MEMBER=user:analyst@example.com
